        </LinearLayout>

        <LinearLayout android:id="@+id/mini_cell_6"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center"
            android:visibility="gone">
            <ImageView android:id="@+id/mini_ind_6"
                android:layout_width="match_parent" android:layout_height="22dp"
                android:scaleType="fitCenter" android:contentDescription="@null"
                android:src="@drawable/ic_status_unknown"/>
            <TextView android:id="@+id/mini_lbl_6"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="7sp" android:textColor="#DDDDDD"
                android:gravity="center" android:singleLine="true"
                android:layout_marginTop="1dp"/>
            <TextView android:id="@+id/mini_sub_6"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="6sp" android:textColor="#888888"
                android:gravity="center" android:singleLine="true"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/mini_cell_7"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center"
            android:visibility="gone">
            <ImageView android:id="@+id/mini_ind_7"
                android:layout_width="match_parent" android:layout_height="22dp"
                android:scaleType="fitCenter" android:contentDescription="@null"
                android:src="@drawable/ic_status_unknown"/>
            <TextView android:id="@+id/mini_lbl_7"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="7sp" android:textColor="#DDDDDD"
                android:gravity="center" android:singleLine="true"
                android:layout_marginTop="1dp"/>
            <TextView android:id="@+id/mini_sub_7"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="6sp" android:textColor="#888888"
                android:gravity="center" android:singleLine="true"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/mini_cell_8"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center"
            android:visibility="gone">
            <ImageView android:id="@+id/mini_ind_8"
                android:layout_width="match_parent" android:layout_height="22dp"
                android:scaleType="fitCenter" android:contentDescription="@null"
                android:src="@drawable/ic_status_unknown"/>
            <TextView android:id="@+id/mini_lbl_8"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="7sp" android:textColor="#DDDDDD"
                android:gravity="center" android:singleLine="true"
                android:layout_marginTop="1dp"/>
            <TextView android:id="@+id/mini_sub_8"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="6sp" android:textColor="#888888"
                android:gravity="center" android:singleLine="true"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
